{
  "name": "prikaz-golosom",
  "productName": "Prikaz golosom",
  "version": "1.2.4",
  "description": "Запись голоса и отправка в polza.ai (OpenAI-совместимый API) для транскрибации",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "hash": "node scripts/generate-sha256.js"
  },
  "dependencies": {
    "openai": "^4.68.0"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.prikazgolosom.app",
    "win": {
      "target": ["nsis", "portable"],
      "signAndEditExecutable": false
    },
    "nsis": {
      "shortcutName": "Prikaz golosom",
      "artifactName": "prikaz-golosom-setup-${version}.exe"
    },
    "portable": {
      "artifactName": "prikaz-golosom-portable-${version}.exe"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "updater.js",
      "recordings.js",
      "index.html",
      "package.json"
    ]
  }
}
