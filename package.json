{
  "name": "prikaz-golosom",
  "productName": "Prikaz golosom",
  "version": "1.4.0",
  "description": "Запись голоса и отправка в polza.ai (OpenAI-совместимый API) для транскрибации — Windows и macOS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "hash": "node scripts/generate-sha256.js"
  },
  "dependencies": {
    "openai": "^4.68.0"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.prikazgolosom.app",
    "productName": "Prikaz golosom",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "shortcutName": "Prikaz golosom",
      "artifactName": "prikaz-golosom-setup-${version}.exe"
    },
    "portable": {
      "artifactName": "prikaz-golosom-portable-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Prikaz golosom записывает голос с микрофона, чтобы расшифровать его в текст."
      }
    },
    "dmg": {
      "artifactName": "prikaz-golosom-${version}-${arch}.dmg"
    },
    "afterPack": "scripts/mac-adhoc-sign.js",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "updater.js",
      "recordings.js",
      "mascot.js",
      "index.html",
      "package.json"
    ]
  }
}
